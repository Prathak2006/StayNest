<% layout("/layouts/boilerplate") -%>
    <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
        }

        .filter {
            text-align: center;
            margin-right: 2rem;
            margin-top: 2rem;
            opacity: 0.7;
        }

        .filter a {
            text-decoration: none;
            color: grey;
        }

        .filter:hover {
            opacity: 1;
            cursor: pointer;
        }

        .filter p {
            font-size: 0.8rem;
        }

        .active-filter {
            color: #fe424d;
            border-bottom: 2px solid #fe424d;
            opacity: 1;
        }

        .active-filter a {
            color: #fe424d;
        }

        .tax-info {
            display: none;
            color: #FF5A5F;
        }

        .tax-toggle {
            border: 1px solid black;
            border-radius: 1rem;
            height: 3rem;
            padding: 1rem;
            display: flex;
            align-items: center;
            margin-top: 2rem;
        }

        @media (max-width: 991px) {

            #filters {
                display: none;
            }

            #filters.show {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 1rem;
            }

            .tax-toggle {
                width: 100%;
                display: flex;
                justify-content: center;
                margin: 1rem 0 0;
                order: 100;
            }

        }
    </style>

    <button class="btn  btn-outline-secondary d-lg-none mb-3 mt-2 filterBtn" id="filterToggle">
        <i class="fa-solid fa-sliders"></i> Filters
    </button>
    <div id="filters">

        <div class="filter  <%= selectedCategory === '' ? 'active-filter' : '' %>">
            <a href="/listings?">
                <div><i class="fa-solid fa-border-all"></i></div>
                ALL
            </a>
        </div>

        <div class="filter  <%= selectedCategory === 'Trending' ? 'active-filter' : '' %>">
            <a href="/listings?category=Trending">
                <div><i class="fa-solid fa-fire"></i></div>
                Trending
            </a>
        </div>

        <div class="filter  <%= selectedCategory === 'Rooms' ? 'active-filter' : '' %>">
            <a href="/listings?category=Rooms">
                <div><i class="fa-solid fa-bed"></i></div>
                Rooms
            </a>
        </div>

        <div class="filter  <%= selectedCategory === 'Iconic-Cities' ? 'active-filter' : '' %>">
            <a href="/listings?category=Iconic-Cities">
                <div><i class="fa-solid fa-mountain-city"></i></div>
                Iconic Cities
            </a>
        </div>

        <div class="filter  <%= selectedCategory === 'Mountains' ? 'active-filter' : '' %>">
            <a href="/listings?category=Mountains">
                <div><i class="fa-solid fa-mountain"></i></div>
                Mountains
            </a>
        </div>

        <div class="filter  <%= selectedCategory === 'Castles' ? 'active-filter' : '' %>">
            <a href="/listings?category=Castles">
                <div><i class="fa-brands fa-fort-awesome"></i></div>
                Castles
            </a>
        </div>

        <div class="filter  <%= selectedCategory === 'Amazing-Pools' ? 'active-filter' : '' %>">
            <a href="/listings?category=Amazing-Pools">
                <div><i class="fa-solid fa-person-swimming"></i></div>
                Amazing Pools
            </a>
        </div>

        <div class="filter  <%= selectedCategory === 'Camping' ? 'active-filter' : '' %>">
            <a href="/listings?category=Camping">
                <div><i class="fa-solid fa-campground"></i></div>
                Camping
            </a>
        </div>

        <div class="filter  <%= selectedCategory === 'Farms' ? 'active-filter' : '' %>">
            <a href="/listings?category=Farms">
                <div><i class="fa-solid fa-cow"></i></div>
                Farms
            </a>
        </div>

        <div class="filter  <%= selectedCategory === 'Arctic' ? 'active-filter' : '' %>">
            <a href="/listings?category=Arctic">
                <div><i class="fa-solid fa-person-skiing-nordic"></i></div>
                Arctic
            </a>
        </div>

        <div class="filter  <%= selectedCategory === 'Domes' ? 'active-filter' : '' %>">
            <a href="/listings?category=Domes">
                <div>
                    <i class="fa-solid fa-igloo"></i>
                </div>
                Domes
            </a>
        </div>
        <div class="filter  <%= selectedCategory === 'Hotel' ? 'active-filter' : '' %>">
            <a href="/listings?category=Hotel">
                <div>
                   <i class="fa-solid fa-hotel"></i>
                </div>
                Hotel
            </a>
        </div>
        <div class="filter  <%= selectedCategory === 'Villa' ? 'active-filter' : '' %>">
            <a href="/listings?category=Villa">
                <div>
                   <i class="fa-solid fa-house"></i>
                </div>
                Villa
            </a>
        </div>

        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
            </div>
        </div>
    </div>
    <div class="row row-cols-lg-3  row-cols-md-2 row-cols-sm-1 mt-3 ">
        <%for(let listing of allListings){%>
            <a href="/listings/<%=listing._id%>" class="listing-link">
                <div class="listing-card card col">
                    <img src="<%= listing.image.url%>" class="card-img-top" alt="listing_image" style="height: 20rem;">

                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text">
                            <b>
                                <%=listing.title%>
                            </b> <br>
                           <span class="base-price"> &#8377; <%=listing.price.toLocaleString("en-IN")%>/Night &nbsp; <i>+18% GST</i></span>
                           <span class="tax-info" >  &#8377; <%= Math.round(listing.price * 1.18).toLocaleString("en-IN") %>/Night</span>
                                
                        </p>
                    </div>
                </div>
            </a>
            <%}%>

    </div>
    <script>
        let taxSwitch = document.getElementById("switchCheckDefault");

        taxSwitch.addEventListener("change", () => {
            let taxInfos = document.getElementsByClassName("tax-info");
            let basePrices = document.getElementsByClassName("base-price");

              for (let i = 0; i < taxInfos.length; i++) {
        if (taxSwitch.checked) {
            taxInfos[i].style.display = "inline";
            basePrices[i].style.display = "none";
        } else {
            taxInfos[i].style.display = "none";
            basePrices[i].style.display = "inline";
        } }

            });

        const filterBtn = document.getElementById("filterToggle");
        const filters = document.getElementById("filters");

        filterBtn.addEventListener("click", () => {
            filters.classList.toggle("show");
            
        });


    </script>